{
  "name": "@quotamesh/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@quotamesh/auth": "workspace:*",
    "@quotamesh/config": "workspace:*",
    "@quotamesh/database": "workspace:*",
    "@quotamesh/validation": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.142.0"
  }
}
